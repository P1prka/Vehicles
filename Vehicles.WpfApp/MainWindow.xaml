<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="600"
        Width="760"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="Vehicles"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Make:"/>
            <TextBox x:Name="MakeTextBox"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Model:"/>
            <TextBox x:Name="ModelTextBox"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Vehicle type:"/>

            <ComboBox x:Name="VehicleTypeComboBox"
                      Margin="0,5,0,10">
                <ComboBoxItem Content="Car"/>
                <ComboBoxItem Content="Boat"/>
                <ComboBoxItem Content="AmphibiousCar"/>
            </ComboBox>

            <Button Content="Add vehicle"
                    Height="35"
                    Click="AddVehicle_Click"
                    Margin="0,0,0,20"/>

            <TextBlock Text="Vehicles:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <ListBox x:Name="VehicleListBox"
                     Height="250"
                     SelectionChanged="VehicleListBox_SelectionChanged"/>

        </StackPanel>

        <!-- Правая часть -->
        <StackPanel Grid.Column="2">

            <TextBlock Text="Selected vehicle"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="SelectedVehicleTextBlock"
                       Text="No vehicle selected."
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="OdometerTextBlock"
                       Text="Odometer: 0 km"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">

                <Button Content="Move 10"
                        Width="100"
                        Height="35"
                        Click="Move_Click"
                        Margin="0,0,10,0"/>

                <Button x:Name="DriveButton"
                        Content="Drive 10"
                        Width="100"
                        Height="35"
                        Click="Drive_Click"
                        Margin="0,0,10,0"/>

                <Button x:Name="SwimButton"
                        Content="Swim 10"
                        Width="100"
                        Height="35"
                        Click="Swim_Click"/>

            </StackPanel>

            <TextBlock Text="Action log:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <ListBox x:Name="LogListBox"
                     Height="250"/>

        </StackPanel>

    </Grid>
</Window>